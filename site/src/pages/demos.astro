---
import Base from '../layouts/Base.astro';
import data from '../data/demos.json';

const demos = data.demos;
const languages = [...new Set(demos.map((d) => d.language))];
const n = (v: number) => v.toLocaleString('en-US');
const time = (v: number) => (v >= 1000 ? `${(v / 1000).toFixed(1)} s` : `${v} ms`);
---
<Base
  title="Demos: real Stacklit maps of six public repos"
  description="Interactive maps generated by Stacklit for gin, flask, hono, ripgrep, gson and rack, each pinned to a release tag."
  path="/demos/"
>
  <div class="container page-head">
    <h1>Real maps of six public repos</h1>
    <p>Each one is the single stacklit.html the tool wrote for a pinned release. Open it, switch views, click a module.</p>
  </div>
  <div class="container demos-body">
    <div class="chips" data-filter aria-label="Filter by language">
      <button class="chip" type="button" aria-pressed="true" data-lang="all">All</button>
      {languages.map((l) => <button class="chip" type="button" aria-pressed="false" data-lang={l}>{l}</button>)}
    </div>
    <ul class="demo-grid">
      {demos.map((d) => (
        <li class="demo" data-lang={d.language}>
          <a class="shot" href={`/demos/${d.id}/`} aria-label={`Open the ${d.name} map`}>
            <img class="shot-light" src={`/demos/${d.id}/thumb-light.webp`} alt={`Light theme screenshot of the Stacklit map for ${d.name}, showing its module graph.`} width="800" height="500" loading="lazy" decoding="async" />
            <img class="shot-dark" src={`/demos/${d.id}/thumb-dark.webp`} alt={`Dark theme screenshot of the Stacklit map for ${d.name}, showing its module graph.`} width="800" height="500" loading="lazy" decoding="async" />
          </a>
          <h3>{d.name} <small>{d.language}, {d.ref}</small></h3>
          <dl>
            <div><dt>Files</dt><dd>{n(d.files)}</dd></div>
            <div><dt>Modules</dt><dd>{n(d.modules)}</dd></div>
            <div><dt>Graph</dt><dd>{n(d.graphNodes)} nodes, {n(d.graphEdges)} edges</dd></div>
            <div><dt>Generated in</dt><dd>{time(d.generateMs)}</dd></div>
            <div><dt>Source lines</dt><dd>{n(d.lines)}</dd></div>
            <div><dt>Map size</dt><dd>{Math.round(d.htmlBytes / 1024)} KB</dd></div>
          </dl>
          <p class="links">
            <a href={`/demos/${d.id}/`}>Open the map</a>
            <a href={`${d.url}/tree/${d.sha}`}>Source at {d.sha}</a>
          </p>
        </li>
      ))}
    </ul>
    <p class="demo-note">Generated with <code>stacklit generate --graph</code> on a shallow clone of each tag, using the default settings. Generation time is one cold run on a laptop and varies by machine. The maps request small language logos from thesvg.org when opened and fall back to letters if blocked. To produce a map with no remote URL at all, set <code>STACKLIT_MAP_ICONS=off</code>. Rebuild everything with <code>npm run demos</code> in the <code>site</code> folder.</p>
  </div>
  <script is:inline>
    (function () {
      var bar = document.querySelector('[data-filter]');
      if (!bar) return;
      bar.classList.add('on');
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('button[data-lang]');
        if (!b) return;
        var lang = b.getAttribute('data-lang');
        bar.querySelectorAll('button').forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
        document.querySelectorAll('.demo').forEach(function (d) { d.hidden = lang !== 'all' && d.getAttribute('data-lang') !== lang; });
      });
    })();
  </script>
</Base>
