---
import Base from '../layouts/Base.astro';
import StarLink from '../components/StarLink.astro';
import InstallBox from '../components/InstallBox.astro';
import Logo from '../components/Logo.astro';
import samples from '../data/samples.json';
import bench from '../data/bench.json';
import copy from '../data/copy.json';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';

const hero = copy.hero.variants[copy.hero.active as keyof typeof copy.hero.variants];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const deriveHtml = samples.derive
  .trimEnd()
  .split('\n')
  .map((l, i) => {
    let h = esc(l);
    if (i === 0) return `<span class="a">${h}</span>`;
    h = h.replace(/(depends:|depended-by:)/g, '<span class="d">$1</span>');
    h = h.replace(/^(modules:|do-not-touch:|test:)/, '<span class="d">$1</span>');
    return h;
  })
  .join('\n');

// Slug pairs: [name, mono-or-single-colour logo, full colour logo]. Aider has no logo on thesvg.org.
const assistants: [string, string | null, string | null][] = [
  ['Claude Code', 'claude-code/mono', 'claude-code/default'],
  ['Cursor', 'cursor/mono', 'cursor/default'],
  ['Codex', 'codex/light', 'codex/default'],
  ['GitHub Copilot', 'github-copilot/mono', 'github-copilot/default'],
  ['Gemini CLI', 'google-gemini/mono', 'google-gemini/default'],
  ['Windsurf', 'windsurf/mono', 'windsurf/default'],
  ['Cline', 'cline/mono', 'cline/default'],
  ['OpenCode', 'opencode/mono', 'opencode/default'],
  ['Zed', 'zed/light', 'zed/default'],
  ['Junie', 'junie/mono', 'junie/default'],
  ['Aider', null, null],
];
const languages: [string, string][] = [['Go', 'go'], ['TypeScript', 'typescript'], ['Python', 'python'], ['Rust', 'rust'], ['Java', 'java']];
const sources: [string, string][] = [['npm', 'npm'], ['go install', 'go'], ['GitHub releases', 'github']];

const armRows: [string, { found1: string; found5: string; tokens: string }][] = [
  ['grep and read', bench.arms.grep],
  ['BM25 over the question', bench.arms.bm25],
  ['stacklit map plus lookup', bench.arms.map],
  ['stacklit query 1000, read in printed order', bench.arms.query],
];
const derive = bench.repos.map((r) => Number(r.deriveTokens));
const deriveMin = Math.min(...derive).toLocaleString('en-US');
const deriveMax = Math.max(...derive).toLocaleString('en-US');

// The real agent A/B appears only when its summary exists at build time.
const abPath = fileURLToPath(new URL('../../../bench/agent-ab/summary.json', import.meta.url));
const hasAb = existsSync(abPath);
---
<Base title={copy.meta.title} description={copy.meta.description} path="/" jsonLd>
  <section class="hero">
    <div class="container">
      <h1>{hero.headline}</h1>
      <p class="lede">{hero.sub}</p>
      <div class="hero-actions">
        <InstallBox />
        <div class="hero-buttons">
          <StarLink />
          <a class="btn" href="/demos/">{copy.cta.demo}</a>
        </div>
      </div>
      <p class="hint">{copy.cta.installHint}</p>
    </div>
  </section>

  <section class="shot-section" aria-label="A real map">
    <div class="container">
      <figure class="map-shot">
        <img class="shot-light" src="/img/map-ripgrep-light.webp" alt="The Stacklit map of ripgrep: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" decoding="async" />
        <img class="shot-dark" src="/img/map-ripgrep-dark.webp" alt="The Stacklit map of ripgrep in the dark theme: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" decoding="async" />
        <figcaption>{copy.cta.mapCaption} <a href="/demos/ripgrep/">{copy.cta.mapLink}</a></figcaption>
      </figure>
      <div class="works">
        <h2>{copy.worksWith.title}</h2>
        <ul class="logos">
          {assistants.map(([name, mono, colour]) => <li><Logo name={name} mono={mono ?? undefined} colour={colour ?? undefined} /></li>)}
        </ul>
        <p class="note">{copy.worksWith.note}</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="container sec-grid">
      <h2>{copy.problem.title}</h2>
      <div class="sec-body">
        <p class="big">{copy.problem.body}</p>
        <p class="cite"><a href={copy.problem.citeUrl} rel="noopener">{copy.problem.citeText}</a>. {copy.problem.caveat}</p>
      </div>
    </div>
  </section>

  <section class="sec" id="how">
    <div class="container sec-grid">
      <h2>{copy.steps.title}</h2>
      <ol class="steps">
        {copy.steps.items.map((s, i) => (
          <li>
            <div>
              <h3><span class="num" aria-hidden="true">{i + 1}</span>{s.name}</h3>
              <p>{s.text}</p>
            </div>
            <div class="cmd"><code><span class="p" aria-hidden="true">$ </span>{s.command}</code><button class="copy" type="button" data-copy={s.command} aria-label={`Copy the ${s.name.toLowerCase()} command`}>Copy</button></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec">
    <div class="container sec-grid">
      <h2>{copy.get.title}</h2>
      <div class="sec-body">
        <dl class="defs">
          {copy.get.items.map((g) => <div><dt>{g.name}</dt><dd>{g.text}</dd></div>)}
        </dl>
        <div class="term">
          <div class="term-head"><span>$ stacklit derive</span><span>gin v1.10.0, {bench.repos[0].deriveTokens} tokens</span></div>
          <pre tabindex="0"><code set:html={deriveHtml} /></pre>
        </div>
        <div class="lang-row">
          <span>Symbol graphs for 20 languages, including</span>
          <ul class="logos small">
            {languages.map(([name, slug]) => <li><Logo name={name} mono={`${slug}/${slug === 'java' ? 'default' : 'mono'}`} colour={`${slug}/default`} size={20} /></li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="proof">
    <div class="container sec-grid">
      <h2>{copy.proof.title}</h2>
      <div class="sec-body">
        <p class="big">{copy.proof.intro}</p>
        <p class="cite">{bench.localizationTasks} tasks across {bench.repoCount} pinned public repos in six languages, run {bench.date}. Intervals are 95% bootstrap intervals over tasks.</p>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Approach</th><th class="num">Found first</th><th class="num">Found in top 5</th><th class="num">Tokens to find</th></tr></thead>
            <tbody>
              {armRows.map(([label, a]) => (
                <tr><td>{label}</td><td class="num">{a.found1}</td><td class="num">{a.found5}</td><td class="num">{a.tokens}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="points">
          <li>Grep and read finds the file first more often, and its search pattern was written by someone who knew the answer. The query command's gap to it is {bench.pairedQueryVsGrep.found1} percentage points at found first and {bench.pairedQueryVsGrep.found5} at top 5. Both intervals reach 0, so the gap is suggestive, not settled.</li>
          <li>The token intervals overlap. We claim no token saving over grep or BM25, and when you already know the exact name, grep is cheaper than loading a map.</li>
          <li>The derive map is {deriveMin} to {deriveMax} tokens on these repos, so it is cheap to hand an agent at the start of a session.</li>
          <li>Scoring was tuned after looking at some failures, and there are limits we list on the benchmark page.</li>
        </ul>
        {hasAb && (
          <div class="ab">
            <h3>{copy.proof.agentAbTitle}</h3>
            <p>{copy.proof.agentAbNote} <a href="https://github.com/glincker/stacklit/blob/master/bench/agent-ab/summary.json">Read the summary and trajectories</a>.</p>
          </div>
        )}
        <p class="cite"><a href="/docs/benchmarks/">Read the full benchmark page</a>, with {bench.totalTasks} tasks in all, methods and limits.</p>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="Plain facts">
    <div class="container">
      <ul>
        {copy.trust.items.map((t) => <li><strong>{t.name}</strong> <span>{t.text}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="sec">
    <div class="container sec-grid">
      <h2>{copy.faq.title}</h2>
      <div class="sec-body faq">
        {copy.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
        <p class="cite"><a href="/docs/faq/">{copy.faq.more}</a></p>
      </div>
    </div>
  </section>

  <section class="sec final">
    <div class="container">
      <h2>{copy.final.title}</h2>
      <p class="lede">{copy.final.text}</p>
      <div class="hero-actions">
        <InstallBox id="install-final" />
        <div class="hero-buttons">
          <StarLink />
          <a class="btn" href="/docs/quickstart/">Quickstart</a>
        </div>
      </div>
      <div class="lang-row">
        <span>Also available through</span>
        <ul class="logos small">
          {sources.map(([name, slug]) => <li><Logo name={name} mono={`${slug}/mono`} colour={`${slug}/default`} size={20} /></li>)}
        </ul>
      </div>
    </div>
  </section>
</Base>
