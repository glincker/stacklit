---
import Landing from '../layouts/Landing.astro';
import Hero from '../sections/Hero.astro';
import Stats from '../sections/Stats.astro';
import Works from '../sections/Works.astro';
import Problem from '../sections/Problem.astro';
import Steps from '../sections/Steps.astro';
import AgentTest from '../sections/AgentTest.astro';
import WhereItHelps from '../sections/WhereItHelps.astro';
import Benchmark from '../sections/Benchmark.astro';
import Trust from '../sections/Trust.astro';
import Faq from '../sections/Faq.astro';
import FinalCta from '../sections/FinalCta.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';
---
<Landing title={copy.meta.title} description={fill(copy.meta.description)} path="/" jsonLd>
  <Hero />
  <Stats />
  <Works />
  <Problem />
  <Steps />
  <AgentTest />
  <WhereItHelps />
  <Benchmark />
  <Trust />
  <Faq />
  <FinalCta />
</Landing>
