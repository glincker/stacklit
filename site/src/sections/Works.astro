---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Legend from '../components/Legend.astro';
import Logo from '../components/Logo.astro';
import copy from '../data/copy.json';

const assistants: [string, string | undefined][] = [
  ['Claude Code', 'claude-code'], ['Cursor', 'cursor'], ['Codex', 'codex'], ['GitHub Copilot', 'github-copilot'],
  ['Gemini CLI', 'google-gemini'], ['Windsurf', 'windsurf'], ['Cline', 'cline'], ['OpenCode', 'opencode'],
  ['Zed', 'zed'], ['Junie', 'junie'], ['Aider', undefined],
];
// Languages with call links, from the edge-kind table in the architecture notes.
const languages: [string, string][] = [
  ['Go', 'go'], ['TypeScript', 'typescript'], ['JavaScript', 'javascript'], ['Python', 'python'], ['Rust', 'rust'], ['Java', 'java'],
  ['C#', 'csharp'], ['Kotlin', 'kotlin'], ['Swift', 'swift'], ['PHP', 'php'], ['Ruby', 'ruby'], ['C', 'c'],
  ['C++', 'c-plusplus'], ['Scala', 'scala'], ['Dart', 'dart'], ['Elixir', 'elixir'], ['Lua', 'lua'], ['Zig', 'zig'],
];
const rows = [
  { key: 'Set up', value: '25 assistants, plus a generic AGENTS.md', href: '/docs/assistants/' },
  { key: 'MCP', value: 'Any client, via stacklit serve', href: '/docs/mcp/' },
  { key: 'Read', value: '48 languages and formats', href: '/docs/languages/' },
  { key: 'Call links', value: '20 languages, who calls what', href: '/docs/languages/' },
];
---
<Section id="works" label="works-title">
  <SectionHead id="works-title" n="03" icon="plug-2" label="Works with" title={copy.assistants.title}>
    <p class="max-w-measure text-body text-muted">{copy.assistants.note}</p>
    <Fragment slot="legend"><Legend title="Legend" rows={rows} /></Fragment>
  </SectionHead>
  <ul class="reveal grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line pt-8 sm:grid-cols-3 lg:grid-cols-4">
    {assistants.map(([name, slug]) => <li class="min-w-0"><Logo name={name} slug={slug} /></li>)}
  </ul>
  <p class="label-mono mb-5 mt-14 text-muted">Call links (who calls what) for 20 languages, including</p>
  <ul class="reveal grid grid-cols-2 gap-x-6 gap-y-5 sm:grid-cols-3 lg:grid-cols-6">
    {languages.map(([name, slug]) => <li class="min-w-0"><Logo name={name} slug={slug} /></li>)}
  </ul>
</Section>
