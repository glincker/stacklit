---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Logo from '../components/Logo.astro';
import copy from '../data/copy.json';

const assistants: [string, string | undefined][] = [
  ['Claude Code', 'claude-code'], ['Cursor', 'cursor'], ['Codex', 'codex'], ['GitHub Copilot', 'github-copilot'],
  ['Gemini CLI', 'google-gemini'], ['Windsurf', 'windsurf'], ['Cline', 'cline'], ['OpenCode', 'opencode'],
  ['Zed', 'zed'], ['Junie', 'junie'], ['Aider', undefined],
];
// Languages with call links, from the edge-kind table in the architecture notes.
const languages: [string, string][] = [
  ['Go', 'go'], ['TypeScript', 'typescript'], ['JavaScript', 'javascript'], ['Python', 'python'], ['Rust', 'rust'], ['Java', 'java'],
  ['C#', 'csharp'], ['Kotlin', 'kotlin'], ['Swift', 'swift'], ['PHP', 'php'], ['Ruby', 'ruby'], ['C', 'c'],
  ['C++', 'c-plusplus'], ['Scala', 'scala'], ['Dart', 'dart'], ['Elixir', 'elixir'], ['Lua', 'lua'], ['Zig', 'zig'],
];
---
<Section id="works" label="works-title" size="md">
  <SectionHead id="works-title" n="07" icon="plug-2" label="Works with" title={copy.assistants.title} />
  <div class="mt-8 grid min-w-0 gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="min-w-0 lg:col-span-5">
      <p class="reveal max-w-measure text-body text-muted">{copy.assistants.note} It reads 48 languages and formats, and builds call links for 20 of them. <a class="text-accent-text underline decoration-1 underline-offset-4 hover:decoration-2" href="/docs/languages/">See the languages</a>.</p>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ul class="reveal grid grid-cols-2 gap-x-6 gap-y-4 sm:grid-cols-3">
        {assistants.map(([name, slug]) => <li class="min-w-0"><Logo name={name} slug={slug} /></li>)}
      </ul>
      <p class="mb-4 mt-8 text-caption font-semibold text-ink">Call links, who calls what, for 20 languages including</p>
      <ul class="reveal grid grid-cols-3 gap-x-6 gap-y-4 sm:grid-cols-4">
        {languages.map(([name, slug]) => <li class="min-w-0"><Logo name={name} slug={slug} /></li>)}
      </ul>
    </div>
  </div>
</Section>
