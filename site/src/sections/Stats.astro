---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Legend from '../components/Legend.astro';
import StatRow from '../components/StatRow.astro';
import Button from '../components/Button.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';

const items = copy.hero.statRow.map((i) => ({ ...i, polarity: i.polarity as 'good' | 'neutral' | 'bad', sentence: fill(i.sentence), number: fill(i.number), means: fill(i.means) }));
const rows = [
  { key: 'Test', value: fill('{sessions} real Claude Code sessions'), href: '/docs/agent-test/' },
  { key: 'Repos', value: '3 public ones', href: '/docs/agent-test/' },
  { key: 'Model', value: 'Sonnet, 30 questions we wrote' },
  { key: 'Planned', value: 'Method written before the first run', href: '/docs/agent-test/' },
];
---
<Section id="results" tone="paper" label="stats-title">
  <SectionHead id="stats-title" n="02" label="Results" title="What happened when we tested it">
    <p class="max-w-measure text-body text-muted">We ran {fill('{sessions}')} real Claude Code sessions, with and without Stacklit. Three results matter most. The good one, the neutral one and the bad one are shown at the same size.</p>
    <Fragment slot="legend"><Legend title="Legend" rows={rows} /></Fragment>
  </SectionHead>
  <StatRow items={items} />
  <p class="mt-8 max-w-measure text-body text-muted">{copy.hero.statRowNote}</p>
  <div class="mt-2"><Button href="/docs/agent-test/" variant="link">See how we measured, with every table</Button></div>
</Section>
