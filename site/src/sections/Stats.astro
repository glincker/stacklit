---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import StatRow from '../components/StatRow.astro';
import Button from '../components/Button.astro';
import UiIcon from '../components/UiIcon.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';

const at = copy.agentTest;
const items = copy.hero.statRow.map((i) => ({ ...i, polarity: i.polarity as 'good' | 'neutral' | 'bad', sentence: fill(i.sentence), number: fill(i.number), means: fill(i.means) }));
---
<Section id="results" label="stats-title">
  <SectionHead id="stats-title" n="05" icon="flask-conical" label="Results" title="What happened when we tested it" size="big" lead={fill(at.intro)} />
  <StatRow items={items} class="mt-10" />
  <p class="mt-6 max-w-measure text-body text-muted">{copy.hero.statRowNote} Turns with the model fell by about a quarter. Editing tasks and other models were not tested.</p>

  <div class="reveal mt-12 grid min-w-0 gap-10 md:grid-cols-2 md:gap-0">
    <div class="min-w-0 border-t border-ink pt-5 md:pe-10">
      <h3 class="flex items-center gap-3 text-h3 font-bold text-accent-text"><UiIcon name="circle-check" size={22} />{at.helpsTitle}</h3>
      <ul class="mt-3 max-w-measure list-disc space-y-2 pl-5 text-body text-ink marker:text-muted">{at.helps.map((t) => <li>{fill(t)}</li>)}</ul>
    </div>
    <div class="min-w-0 border-t border-ink pt-5 md:border-s md:border-line md:ps-10">
      <h3 class="flex items-center gap-3 text-h3 font-bold text-bad"><UiIcon name="triangle-alert" size={22} />{at.failsTitle}</h3>
      <ul class="mt-3 max-w-measure list-disc space-y-2 pl-5 text-body text-ink marker:text-muted">{at.fails.map((t) => <li>{fill(t)}</li>)}</ul>
    </div>
  </div>
  <div class="mt-4"><Button href={at.linkHref} variant="link">See how we measured, with every table</Button></div>
</Section>
