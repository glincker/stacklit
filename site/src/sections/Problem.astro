---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';
const c = copy.problem.citation;
---
<Section tone="surface" label="problem-title">
  <SectionHead id="problem-title" title={copy.problem.title} />
  <div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:gap-12">
    <p class="min-w-0 max-w-measure text-lead text-ink lg:col-span-6">{fill(copy.problem.body)}</p>
    <figure class="min-w-0 border-l-2 border-line-strong pl-5 lg:col-span-6">
      <blockquote class="max-w-measure text-body text-ink"><p>{c.text}</p></blockquote>
      <figcaption class="mt-3 max-w-measure text-caption text-muted"><a href={c.url} rel="noopener" class="underline decoration-1 underline-offset-4 hover:decoration-2">{c.source}</a></figcaption>
      <p class="mt-3 max-w-measure text-caption text-muted">{c.caveat}</p>
    </figure>
  </div>
</Section>
