---
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import UiIcon from '../components/UiIcon.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';
const c = copy.problem.citation;
const title = copy.problem.title;
---
<Section id="problem" label="problem-title" size="md">
  <div class="grid min-w-0 gap-8 lg:grid-cols-12 lg:gap-12">
    <div class="min-w-0 lg:col-span-7">
      <Kicker n="02" icon="triangle-alert" label="The problem" class="reveal" />
      <h2 id="problem-title" class="reveal mt-5 min-w-0 max-w-[22ch] break-words text-h2 font-bold text-ink">{title}</h2>
      <p class="reveal mt-5 max-w-measure text-lead text-ink">{fill(copy.problem.body)}</p>
    </div>
    <figure class="reveal min-w-0 self-end lg:col-span-5 lg:border-l lg:border-line lg:pl-10">
      <p class="text-caption font-semibold text-ink">A study of other agents, not our result</p>
      <blockquote class="mt-2 max-w-measure text-body text-muted"><p>{c.text}</p></blockquote>
      <figcaption class="mt-3 max-w-measure text-caption text-muted"><a href={c.url} rel="noopener" class="inline-flex items-center gap-1 underline decoration-1 underline-offset-4 hover:decoration-2">{c.source}<UiIcon name="arrow-up-right" size={12} /></a><span class="mt-1 block">One preprint, one benchmark.</span></figcaption>
    </figure>
  </div>
</Section>
