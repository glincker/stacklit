---
import Section from '../components/Section.astro';
import UiIcon from '../components/UiIcon.astro';
import SectionHead from '../components/SectionHead.astro';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';
const c = copy.problem.citation;
---
<Section id="problem" label="problem-title">
  <SectionHead id="problem-title" n="04" icon="triangle-alert" label="The problem" title={copy.problem.title} />
  <div class="grid min-w-0 gap-10 lg:grid-cols-12 lg:gap-12">
    <p class="reveal min-w-0 max-w-measure text-lead text-ink lg:col-span-7">{fill(copy.problem.body)}</p>
    <figure class="reveal min-w-0 lg:col-span-5 lg:border-l lg:border-line lg:pl-10">
      <p class="label-mono mb-3 text-faint">A study of other agents, not our result</p>
      <blockquote class="max-w-measure text-body text-ink"><p>{c.text}</p></blockquote>
      <figcaption class="mt-3 max-w-measure text-caption text-muted"><a href={c.url} rel="noopener" class="inline-flex items-center gap-1 underline decoration-1 underline-offset-4 hover:decoration-2">{c.source}<UiIcon name="arrow-up-right" size={12} /></a></figcaption>
      <p class="mt-3 max-w-measure text-caption text-muted">{c.caveat}</p>
    </figure>
  </div>
</Section>
