---
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import Button from '../components/Button.astro';
import bench from '../data/bench.json';
import copy from '../data/copy.json';

const first = (s: string) => s.split(' ')[0];
const derive = bench.repos.map((r) => Number(r.deriveTokens));
const range = `${Math.min(...derive).toLocaleString('en-US')} to ${Math.max(...derive).toLocaleString('en-US')}`;
const lines: [string, string, string][] = [
  [first(bench.arms.query.found1), 'Stacklit, one short query', 'The right file came first on this share of questions.'],
  [first(bench.arms.grep.found1), 'Grep, with a pattern written by someone who knew the answer', 'Better than Stacklit at the first file.'],
  [first(bench.arms.bm25.found1), 'Plain keyword search', 'Worse at the first file.'],
];
---
<Section id="benchmark" label="bench-title" tone="surface">
  <div class="grid min-w-0 gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="min-w-0 lg:col-span-5">
      <Kicker n="06" icon="gauge" label="Benchmark" class="reveal" />
      <h2 id="bench-title" class="reveal mt-5 max-w-[22ch] text-h2 font-bold text-ink">{copy.proof.title}</h2>
      <p class="reveal mt-5 max-w-measure text-body text-ink">{copy.proof.intro}</p>
      <p class="reveal mt-4 max-w-measure text-body text-muted">{copy.proof.sizes.replace('{range}', range)}</p>
    </div>
    <div class="min-w-0 lg:col-span-7">
      <ul class="border-t border-ink">
        {lines.map(([n, who, what]) => (
          <li class="reveal grid min-w-0 grid-cols-[minmax(5.5rem,auto)_1fr] items-baseline gap-x-6 border-b border-line py-5 sm:grid-cols-[8rem_1fr]">
            <p class="text-stat font-bold text-ink">{n}</p>
            <div class="min-w-0">
              <p class="text-h3 text-ink">{who}</p>
              <p class="mt-1 text-body text-muted">{what}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="reveal mt-6 max-w-measure text-body text-ink">{copy.proof.note}</p>
      <p class="reveal mt-3 max-w-measure text-body text-muted">We do not claim it saves tokens over grep. When you already know the exact name, grep is cheaper than loading a map.</p>
      <div class="mt-3"><Button href="/docs/benchmarks/" variant="link">See how we measured, with every table and limit</Button></div>
    </div>
  </div>
</Section>
