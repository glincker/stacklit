---
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import UiIcon from '../components/UiIcon.astro';
import StarButton from '../components/StarButton.astro';
import CodeBlock from '../components/CodeBlock.astro';
import SetupPrompt from '../components/SetupPrompt.astro';
import HeroMap from '../components/HeroMap.astro';
import release from '../data/release.json';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';

const hero = copy.hero.variants[copy.hero.active as keyof typeof copy.hero.variants];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// A hyphenated word must not break at its hyphen.
const headline = esc(fill(hero.headline)).replace(/\b(\w+-\w+)\b/g, '<span class="whitespace-nowrap">$1</span>');
const facts: { icon: string; text: string; href?: string }[] = [
  { icon: 'tag', text: `v${release.version}, ${release.date}`, href: `https://github.com/glincker/stacklit/releases/tag/v${release.version}` },
  { icon: 'scale', text: 'MIT, free', href: 'https://github.com/glincker/stacklit/blob/master/LICENSE' },
  { icon: 'computer', text: 'Runs on your machine' },
  { icon: 'shield-off', text: 'No telemetry', href: '/docs/privacy/' },
];
// The text column stops before the picture begins, at every width from lg up.
const col = 'lg:w-[min(38rem,calc(50vw-4rem))]';
---
<Section id="overview" label="hero-title" size="hero">
  <div class:list={['min-w-0', col]}>
    <Kicker n="01" icon="map" label="Overview" class="reveal" />
    <h1 id="hero-title" class="mt-6 text-hero-split font-bold text-ink" set:html={headline} />
    <p class="mt-6 max-w-measure text-lead text-ink">{fill(hero.sub)}</p>
    <div class="mt-6 max-w-measure space-y-4">
      <div class="action-row">
        <StarButton />
        <CodeBlock inline copy prompt code={copy.hero.install} class="w-fit max-w-full" />
      </div>
      <p class="text-caption text-muted">{copy.hero.installNote}</p>
      <p><a class="inline-flex min-h-11 items-center gap-1.5 text-body font-semibold text-accent-text underline decoration-1 underline-offset-4 hover:decoration-2" href={copy.hero.secondaryHref}>{copy.hero.secondaryCta}<UiIcon name="arrow-right" size={16} /></a></p>
      <SetupPrompt />
    </div>
  </div>
  <HeroMap class="mt-12 lg:absolute lg:inset-y-0 lg:right-0 lg:mt-0 lg:flex lg:w-[46%] lg:flex-col lg:justify-center lg:overflow-hidden lg:pt-8" />
  <ul class:list={['mt-8 flex min-w-0 flex-wrap gap-x-6 gap-y-2 text-caption text-muted', col]}>
    {facts.map((f) => (
      <li class="inline-flex items-center gap-2">
        <UiIcon name={f.icon} size={14} />
        {f.href ? <a href={f.href} class="underline decoration-line-strong decoration-1 underline-offset-4 hover:decoration-ink">{f.text}</a> : f.text}
      </li>
    ))}
  </ul>
</Section>
