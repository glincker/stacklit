---
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import Legend from '../components/Legend.astro';
import Button from '../components/Button.astro';
import UiIcon from '../components/UiIcon.astro';
import StarButton from '../components/StarButton.astro';
import CodeBlock from '../components/CodeBlock.astro';
import CodeWindow from '../components/CodeWindow.astro';
import SetupPrompt from '../components/SetupPrompt.astro';
import samples from '../data/samples.json';
import bench from '../data/bench.json';
import ask from '../data/ask.json';
import release from '../data/release.json';
import copy from '../data/copy.json';
import { fill } from '../data/agentAb';
import { queryClasses } from '../data/codeClasses';

const hero = copy.hero.variants[copy.hero.active as keyof typeof copy.hero.variants];
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// A hyphenated word must not break at its hyphen.
const headline = esc(fill(hero.headline)).replace(/\b(\w+-\w+)\b/g, '<span class="whitespace-nowrap">$1</span>');
const tokens = bench.repos[0].deriveTokens;
const rc = readFileSync(resolve(process.cwd(), '../.stacklitrc.json'), 'utf8').trimEnd();
const q = ask.asks[0];
const derive = samples.derive.trimEnd();
const rows = [
  { key: 'Type', value: 'Command line tool' },
  { key: 'License', value: 'MIT, free to use', href: 'https://github.com/glincker/stacklit/blob/master/LICENSE' },
  { key: 'Binary', value: 'One file, written in Go' },
  { key: 'Languages', value: '48 read, 20 with call links', href: '/docs/languages/' },
  { key: 'Assistants', value: '25 set up for you', href: '/docs/assistants/' },
  { key: 'Runs', value: 'On your machine' },
  { key: 'Telemetry', value: 'None, nothing sent', href: '/docs/privacy/' },
  { key: 'Version', value: `v${release.version}, ${release.date}`, href: `https://github.com/glincker/stacklit/releases/tag/v${release.version}` },
];
const deriveLines: Record<number, string> = { 1: 'ln-cmd', 2: 'ln-key', 5: 'ln-dim' };
const tabs = [
  { label: 'stacklit derive', icon: 'terminal', lang: 'text', code: `$ stacklit derive\n${derive}`, copy: 'stacklit derive', classes: deriveLines, caption: `stacklit derive on gin, a Go web framework with 19,500 lines. The whole map is ${tokens} tokens, about ${Math.round(Number(tokens) * 0.75)} words.` },
  { label: 'stacklit query', icon: 'search', lang: 'text', code: `$ ${q.command}\n${q.output}`, copy: q.command, classes: { 1: 'ln-cmd', ...queryClasses(q.output, 1) }, caption: `A plain question, answered with a ranked list of files. Recorded on gin, ${q.tokens} tokens, under the ${ask.budget} we allowed.` },
  { label: '.stacklitrc.json', icon: 'json-file', lang: 'json', code: rc, highlight: [3], caption: 'This repo’s own .stacklitrc.json. Every key is optional. Line 3 moves the diagram file.' },
  { label: 'claude plugin install', icon: 'plug-2', lang: 'bash', code: 'claude plugin marketplace add glincker/stacklit\nclaude plugin install stacklit@stacklit', caption: 'Two commands add the Claude Code plugin. It needs the stacklit program installed first.' },
];
---
<Section id="overview" label="hero-title" size="hero">
  <Kicker n="01" icon="map" label="Overview" class="reveal" />
  <h1 id="hero-title" class="mt-8 max-w-[19ch] text-display font-bold text-ink" set:html={headline} />
  <div class="mt-8 grid min-w-0 gap-10 lg:mt-10 lg:grid-cols-12 lg:gap-12">
    <div class="min-w-0 lg:col-span-7">
      <p class="max-w-measure text-lead text-ink">{fill(hero.sub)}</p>
      <p class="mt-1"><a class="inline-flex min-h-11 items-center gap-1.5 text-body font-semibold text-accent-text underline decoration-1 underline-offset-4 hover:decoration-2" href={copy.hero.secondaryHref}>{copy.hero.secondaryCta}<UiIcon name="arrow-right" size={16} /></a></p>
      <div class="mt-6 max-w-measure space-y-4">
        <SetupPrompt />
        <div class="action-row">
          <StarButton />
          <CodeBlock inline copy prompt code={copy.hero.install} class="w-fit max-w-full" />
        </div>
        <p class="text-caption text-muted">{copy.hero.installNote}</p>
      </div>
    </div>
    <aside class="min-w-0 lg:col-span-5 lg:border-l lg:border-line lg:pl-10">
      <Legend title="Legend" rows={rows} />
    </aside>
  </div>
  <div class="reveal mt-12 sm:mt-16">
    <CodeWindow name="hero" label="Real Stacklit output and setup" tabs={tabs} />
    <p class="mt-4 max-w-measure text-caption text-muted">{copy.hero.caption}</p>
  </div>
</Section>
