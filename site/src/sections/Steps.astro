---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Legend from '../components/Legend.astro';
import CodeWindow from '../components/CodeWindow.astro';
import copy from '../data/copy.json';
import steps from '../data/steps.json';
import ask from '../data/ask.json';
import { queryClasses } from '../data/codeClasses';

// Real recorded output for each step, on gin v1.10.0. The third step reuses the recorded query.
const q = ask.asks[0];
const win = [
  { label: 'stacklit init', code: `$ stacklit init\n${steps.init}`, copy: copy.steps.items[0].command, classes: { 1: 'ln-cmd' } as Record<number, string>, caption: `recorded on ${steps.repo}. npx stacklit init runs the same command` },
  { label: 'stacklit setup', code: `$ ${copy.steps.items[1].command}\n${steps.setup}`, copy: copy.steps.items[1].command, classes: { 1: 'ln-cmd' } as Record<number, string>, caption: `recorded on ${steps.repo}, in a clean copy` },
  { label: 'stacklit query', code: `$ ${q.command}\n${q.output}`, copy: q.command, classes: { 1: 'ln-cmd', ...queryClasses(q.output, 1) } as Record<number, string>, caption: `${q.command}, recorded on ${ask.repo}` },
];
const rows = [
  { key: 'Install', value: 'npm, go install or a release', href: '/docs/install/' },
  { key: 'Writes', value: 'stacklit.json, a diagram, a map' },
  { key: 'Parser', value: 'tree-sitter, no LLM' },
  { key: 'Updates', value: 'Git hooks rebuild the map' },
];
---
<Section id="how" label="how-title">
  <SectionHead id="how-title" n="06" label="How it works" title={copy.steps.title}>
    <p class="max-w-measure text-body text-muted">Three commands. The output under each is the real thing, recorded on gin v1.10.0.</p>
    <Fragment slot="legend"><Legend title="Legend" rows={rows} /></Fragment>
  </SectionHead>
  <ol class="min-w-0 border-t border-line">
    {copy.steps.items.map((s, i) => (
      <li class="reveal grid min-w-0 grid-cols-1 gap-6 border-b border-line py-10 lg:grid-cols-12 lg:gap-12">
        <div class="min-w-0 lg:col-span-5">
          <p class="label-mono text-muted">Step {i + 1}</p>
          <h3 class="mt-3 text-h2 font-bold text-ink">{s.name}</h3>
          <p class="mt-3 max-w-measure text-body text-muted">{s.text}</p>
        </div>
        <div class="min-w-0 lg:col-span-7">
          <CodeWindow name={`step${i}`} label={`Step ${i + 1}: ${s.name}`} tabs={[{ lang: 'text', ...win[i] }]} class="[--codewin-max:18rem]" />
        </div>
      </li>
    ))}
  </ol>
  <figure class="reveal mt-14 min-w-0">
    <img class="w-full rounded-frame border border-line-strong dark:hidden" src="/img/map-ripgrep-light.webp" alt="The Stacklit map of ripgrep: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" loading="lazy" decoding="async" />
    <img class="hidden w-full rounded-frame border border-line-strong dark:block" src="/img/map-ripgrep-dark.webp" alt="The Stacklit map of ripgrep in the dark theme: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" loading="lazy" decoding="async" />
    <figcaption class="mt-3 max-w-measure text-caption text-muted">{copy.cta.mapCaption} <a class="underline decoration-1 underline-offset-4 hover:decoration-2" href="/demos/ripgrep/">{copy.cta.mapLink}</a></figcaption>
  </figure>
</Section>
