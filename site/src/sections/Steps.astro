---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import CodeBlock from '../components/CodeBlock.astro';
import copy from '../data/copy.json';
---
<Section id="how" label="how-title">
  <SectionHead id="how-title" title={copy.steps.title} />
  <ol class="min-w-0 divide-y divide-line border-y border-line">
    {copy.steps.items.map((s, i) => (
      <li class="grid min-w-0 grid-cols-1 items-center gap-4 py-6 lg:grid-cols-12 lg:gap-10">
        <div class="min-w-0 lg:col-span-5">
          <h3 class="text-h3 text-ink"><span class="mr-2 text-accent-text">{i + 1}.</span>{s.name}</h3>
          <p class="mt-2 max-w-measure text-body text-muted">{s.text}</p>
        </div>
        <div class="min-w-0 lg:col-span-7"><CodeBlock inline copy prompt code={s.command} /></div>
      </li>
    ))}
  </ol>
  <figure class="mt-12 min-w-0">
    <img class="w-full rounded-lg border border-line dark:hidden" src="/img/map-ripgrep-light.webp" alt="The Stacklit map of ripgrep: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" loading="lazy" decoding="async" />
    <img class="hidden w-full rounded-lg border border-line dark:block" src="/img/map-ripgrep-dark.webp" alt="The Stacklit map of ripgrep in the dark theme: a graph of 34 modules sized by lines of code, with the most depended-on modules listed beside it." width="1440" height="900" loading="lazy" decoding="async" />
    <figcaption class="mt-3 max-w-measure text-caption text-muted">{copy.cta.mapCaption} <a class="underline decoration-1 underline-offset-4 hover:decoration-2" href="/demos/ripgrep/">{copy.cta.mapLink}</a></figcaption>
  </figure>
</Section>
