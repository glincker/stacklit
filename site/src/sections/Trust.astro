---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Legend from '../components/Legend.astro';
import release from '../data/release.json';
import copy from '../data/copy.json';
const v = `v${release.version}`;
const rows = [
  { key: 'Version', value: `${v}, ${release.date}`, href: `https://github.com/glincker/stacklit/releases/tag/${v}` },
  { key: 'License', value: 'MIT', href: 'https://github.com/glincker/stacklit/blob/master/LICENSE' },
  { key: 'Source', value: 'github.com/glincker/stacklit', href: 'https://github.com/glincker/stacklit' },
  { key: 'npm', value: 'Published with a build record', href: 'https://www.npmjs.com/package/stacklit' },
  { key: 'Checksums', value: 'File fingerprints for this release', href: `https://github.com/glincker/stacklit/releases/download/${v}/checksums.txt` },
  { key: 'Network', value: 'No requests of its own', href: '/docs/privacy/' },
  { key: 'Assistants', value: '25 set up', href: '/docs/assistants/' },
];
---
<Section id="facts" label="trust-title">
  <SectionHead id="trust-title" n="10" label="Plain facts" title="Plain facts, and how to check them">
    <p class="max-w-measure text-body text-muted"><span class="font-semibold text-ink">Verify.</span> The release files are listed with their fingerprints (checksums) for {v}, and the npm package is published with a build record (npm calls it provenance) that shows it came from our release workflow. The privacy page says what the program does on the network, and the source is public.</p>
    <Fragment slot="legend"><Legend title="Legend: provenance" rows={rows} /></Fragment>
  </SectionHead>
  <ul class="grid min-w-0 gap-x-12 sm:grid-cols-2">
    {copy.trust.items.map((t) => <li class="reveal min-w-0 border-t border-line py-5 text-lead text-ink">{t}</li>)}
  </ul>
</Section>
