---
import Section from '../components/Section.astro';
import Kicker from '../components/Kicker.astro';
import Button from '../components/Button.astro';
import StarButton from '../components/StarButton.astro';
import CodeBlock from '../components/CodeBlock.astro';
import SetupPrompt from '../components/SetupPrompt.astro';
import Logo from '../components/Logo.astro';
import copy from '../data/copy.json';
const sources: [string, string][] = [['npm', 'npm'], ['Homebrew', 'homebrew'], ['go install', 'go'], ['GitHub releases', 'github']];
---
<Section id="try" label="final-title">
  <Kicker n="09" icon="rocket" label="Try it" class="reveal" />
  <h2 id="final-title" class="reveal mt-5 max-w-[10ch] text-finale font-bold text-ink">Try it in a minute.</h2>
  <div class="mt-8 grid min-w-0 gap-10 lg:mt-10 lg:grid-cols-12 lg:gap-12">
    <div class="reveal min-w-0 lg:col-span-7">
      <p class="max-w-measure text-lead text-ink">{copy.final.text}</p>
      <div class="mt-8 max-w-measure space-y-4">
        <CodeBlock inline copy prompt code={copy.cta.install} />
        <SetupPrompt />
        <div class="action-row">
          <StarButton variant="primary" />
          <Button href="/docs/quickstart/" variant="secondary" icon="book-open">Quickstart</Button>
        </div>
      </div>
    </div>
    <div class="reveal min-w-0 lg:col-span-5 lg:border-l lg:border-line lg:pl-10">
      <p class="mb-4 text-caption font-semibold text-ink">Also available through</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-4">
        {sources.map(([name, slug]) => <li><Logo name={name} slug={slug} /></li>)}
      </ul>
    </div>
  </div>
</Section>
