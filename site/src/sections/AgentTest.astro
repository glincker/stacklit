---
import Section from '../components/Section.astro';
import SectionHead from '../components/SectionHead.astro';
import Legend from '../components/Legend.astro';
import Button from '../components/Button.astro';
import copy from '../data/copy.json';
import { ab, fill } from '../data/agentAb';

const at = copy.agentTest;
const rows = [
  { key: 'Sessions', value: fill('{sessions} real runs'), href: '/docs/agent-test/' },
  { key: 'Repos', value: '3 public ones', href: '/docs/agent-test/' },
  { key: 'Pairs', value: 'Each question, with and without', href: '/docs/agent-test/' },
  { key: 'Cost', value: "Claude Code's own list price estimate" },
];
const behaviour = [
  'About a third fewer tool calls.',
  'About a quarter fewer turns with the model.',
  'More than four fifths fewer grep and glob searches.',
  fill('Answers were right slightly less often: {correctControl}% without Stacklit, {correctArm}% with it. After we fixed three grading mistakes of ours: {auditedControl}% and {auditedArm}%, and that gap could be chance.'),
  'The bill stayed about the same overall. It fell on the biggest repo and rose on the smallest.',
];
---
<Section id="agent-test" label="agent-title">
  <SectionHead id="agent-title" n="07" icon="flask-conical" label="Agent test" title={at.title} lead={fill(at.intro)}>
    <Fragment slot="legend"><Legend title="Legend" rows={rows} /></Fragment>
  </SectionHead>
  <h3 class="mb-4 text-h2 font-bold text-ink">{at.behaviourTitle}</h3>
  <ul class="reveal max-w-measure list-disc space-y-3 pl-5 text-lead text-ink marker:text-muted">
    {behaviour.map((b) => <li>{b}</li>)}
  </ul>
  <p class="mt-8 max-w-measure text-body text-muted">{at.limits}</p>
  <div class="mt-4"><Button href={at.linkHref} variant="link">See how we measured, with the tables and ranges</Button></div>
</Section>
