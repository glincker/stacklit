---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ReleaseBanner from '../components/ReleaseBanner.astro';
import ChapterRail from '../components/ChapterRail.astro';
import { SITE } from '../data/site';
import copy from '../data/copy.json';

interface Props { title: string; description: string; path: string; noindex?: boolean; jsonLd?: boolean; image?: string; rail?: boolean }
const { title, description, path, noindex = false, jsonLd = false, image = '/og/default-light.png', rail = false } = Astro.props;
const canonical = SITE + path;
const imageUrl = SITE + image;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Stacklit',
  description: copy.meta.structured,
  url: SITE + '/',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  license: 'https://opensource.org/licenses/MIT',
  codeRepository: 'https://github.com/glincker/stacklit',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<!doctype html>
<html lang="en" class="overflow-x-clip">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151410" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Stacklit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content={copy.og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      // Same storage key as the docs, so the choice follows the visitor across both.
      (function () {
        var t = '';
        try { t = localStorage.getItem('starlight-theme') || ''; } catch (e) {}
        var dark = t === 'dark' || (t !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        document.documentElement.classList.add('js');
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-raised focus:px-4 focus:py-2 focus:text-ink">Skip to content</a>
        <ReleaseBanner />
    <Header path={path} />
    {rail && <ChapterRail />}
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>
      document.addEventListener('click', function (e) {
        var tg = e.target.closest && e.target.closest('[data-theme-toggle]');
        if (tg) {
          var root = document.documentElement;
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('starlight-theme', next); } catch (err) {}
          return;
        }
        var b = e.target.closest && e.target.closest('[data-copy]');
        if (!b || !navigator.clipboard) return;
        navigator.clipboard.writeText(b.getAttribute('data-copy')).then(function () {
          var l = b.querySelector('[data-copy-label]') || b;
          var t = l.textContent;
          l.textContent = 'Copied';
          b.setAttribute('data-state', 'copied');
          setTimeout(function () { l.textContent = t; b.removeAttribute('data-state'); }, 1600);
        }, function () {});
      });
    </script>
  </body>
</html>
<style is:global>
  html { overflow-x: clip; }
  body { overflow-x: clip; }
</style>
