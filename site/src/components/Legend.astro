---
import UiIcon from './UiIcon.astro';
// The spec table, drawn as a map legend: hairline rows, mono keys, real facts only. A value may link to its source.
// Each key carries a small hairline icon (the default for a key is in `glyphs`; a row may override with `icon`).
interface Row { key: string; value: string; href?: string; icon?: string }
interface Props { title?: string; rows: Row[]; class?: string }
const { title = 'Legend', rows, class: extra } = Astro.props;
const glyphs: Record<string, string> = {
  Type: 'terminal', License: 'scale', Binary: 'package', Languages: 'languages', Assistants: 'bot', Runs: 'computer',
  Telemetry: 'shield-off', Version: 'tag', 'Set up': 'settings-2', MCP: 'plug-2', Read: 'file-code', 'Call links': 'workflow',
  Test: 'flask-conical', Sessions: 'flask-conical', Repos: 'folder', Repo: 'folder', Model: 'brain', Planned: 'calendar-check',
  Pairs: 'between-horizontal-end', Cost: 'coins', Install: 'download', Writes: 'file-text', 'Built by': 'cpu', Updates: 'refresh-cw',
  Mode: 'circle-dot', Limit: 'gauge', Source: 'code', npm: 'package', Checksums: 'fingerprint-pattern', Network: 'wifi-off',
  Questions: 'circle-question-mark', Reader: 'eye', Run: 'clock',
};
const isExternal = (h?: string) => Boolean(h && /^https?:/.test(h));
---
<div class:list={['min-w-0', extra]}>
  <p class="label-mono mb-3 text-faint">{title}</p>
  <dl class="border-t border-line">
    {rows.map((r) => {
      const icon = r.icon ?? glyphs[r.key];
      return (
        <div class="grid grid-cols-[minmax(6.5rem,auto)_1fr] gap-x-6 border-b border-line py-3">
          <dt class="label-mono flex items-center gap-2 text-muted">{icon && <UiIcon name={icon} size={14} />}{r.key}</dt>
          <dd class="label-mono min-w-0 text-right text-ink [overflow-wrap:anywhere]">
            {r.href
              ? <a href={r.href} class="underline decoration-line-strong decoration-1 underline-offset-4 transition-colors duration-fast hover:decoration-ink">{r.value}{isExternal(r.href) && <UiIcon name="arrow-up-right" size={12} class="ms-1 inline-block align-[-1px]" />}</a>
              : r.value}
          </dd>
        </div>
      );
    })}
  </dl>
</div>
