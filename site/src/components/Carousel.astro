---
import CodeWindow from './CodeWindow.astro';
import UiIcon from './UiIcon.astro';
// A scroll-snap strip of real screens: recorded terminal output and the maps Stacklit wrote. No autoplay.
// It scrolls and snaps without a script (swipe, wheel, arrow keys on the focused strip). The buttons and the counter
// need the small script below and stay hidden without it.
interface Term { kind: 'term'; label: string; code: string; copy: string; classes?: Record<number, string>; caption: string }
interface Pic { kind: 'pic'; light: string; dark: string; alt: string; width: number; height: number; caption: string; href?: string; cta?: string }
interface Props { items: (Term | Pic)[]; label: string; name: string; class?: string }
const { items, label, name, class: extra } = Astro.props;
const total = items.length;
---
<div class:list={['car min-w-0', extra]} data-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="car-ctl mb-4 items-center justify-end gap-3">
    <p class="text-caption text-muted" aria-live="polite"><span data-car-now>1</span> of {total}</p>
    <button type="button" data-car-prev class="grid size-11 place-items-center rounded-full border border-line-strong bg-raised text-ink transition-colors duration-fast hover:bg-sunk aria-disabled:opacity-40 motion-reduce:transition-none" aria-label="Previous screen"><UiIcon name="arrow-left" size={18} /></button>
    <button type="button" data-car-next class="grid size-11 place-items-center rounded-full border border-line-strong bg-raised text-ink transition-colors duration-fast hover:bg-sunk aria-disabled:opacity-40 motion-reduce:transition-none" aria-label="Next screen"><UiIcon name="arrow-right" size={18} /></button>
  </div>
  <ul class="car-track flex min-w-0 gap-5" tabindex="0" aria-label={`${label}, scroll sideways`}>
    {items.map((it, i) => (
      <li class="car-slide min-w-0" role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${total}`}>
        <figure class="min-w-0">
          {it.kind === 'term'
            ? <div class="car-term"><CodeWindow name={`${name}${i}`} label={it.label} tabs={[{ label: it.label, icon: 'terminal', lang: 'text', code: it.code, copy: it.copy, classes: it.classes }]} /></div>
            : <div class="car-pic overflow-hidden rounded-frame border border-line-strong bg-sunk">
                <img class="size-full object-contain dark:hidden" src={it.light} alt={`Light theme. ${it.alt}`} width={it.width} height={it.height} loading="lazy" decoding="async" />
                <img class="hidden size-full object-contain dark:block" src={it.dark} alt={`Dark theme. ${it.alt}`} width={it.width} height={it.height} loading="lazy" decoding="async" />
              </div>}
          <figcaption class="mt-3 max-w-measure text-caption text-muted">{it.caption}{it.kind === 'pic' && it.href && <> <a class="underline decoration-1 underline-offset-4 hover:decoration-2" href={it.href}>{it.cta ?? 'Open it'}</a></>}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</div>
<script is:inline>
  (function () {
    document.querySelectorAll('[data-carousel]').forEach(function (root) {
      var track = root.querySelector('.car-track');
      var slides = Array.prototype.slice.call(track.children);
      var now = root.querySelector('[data-car-now]');
      var prev = root.querySelector('[data-car-prev]');
      var next = root.querySelector('[data-car-next]');
      var reduce = matchMedia('(prefers-reduced-motion: reduce)');
      function index() {
        var x = track.scrollLeft + 4, best = 0;
        slides.forEach(function (s, i) { if (s.offsetLeft - track.offsetLeft <= x) best = i; });
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 4) best = slides.length - 1;
        return best;
      }
      function update() {
        var i = index();
        now.textContent = String(i + 1);
        prev.setAttribute('aria-disabled', i === 0 ? 'true' : 'false');
        next.setAttribute('aria-disabled', i === slides.length - 1 ? 'true' : 'false');
      }
      function go(d) {
        var i = Math.max(0, Math.min(slides.length - 1, index() + d));
        track.scrollTo({ left: slides[i].offsetLeft - track.offsetLeft, behavior: reduce.matches ? 'auto' : 'smooth' });
      }
      prev.addEventListener('click', function () { go(-1); });
      next.addEventListener('click', function () { go(1); });
      var raf = 0;
      track.addEventListener('scroll', function () { cancelAnimationFrame(raf); raf = requestAnimationFrame(update); }, { passive: true });
      update();
    });
  })();
</script>
