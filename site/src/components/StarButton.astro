---
import stars from '../data/stars.json';
import copy from '../data/copy.json';
import { REPO } from '../data/site';
import Button from './Button.astro';
interface Props { variant?: 'secondary' | 'ghost'; size?: 'md' | 'sm'; label?: string }
const { variant = 'secondary', size = 'md', label = copy.cta.star } = Astro.props;
const n = stars.stars;
const shown = typeof n === 'number' ? (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n)) : null;
---
<Button href={REPO} variant={variant} size={size}>
  <svg viewBox="0 0 24 24" class="size-4 shrink-0 text-accent-text" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" fill="currentColor"/></svg>
  <span>{label}</span>
  {shown && <span class="rounded-sm bg-sunk px-1.5 text-caption tabular-nums" aria-label={`${n} stars`}>{shown}</span>}
</Button>
