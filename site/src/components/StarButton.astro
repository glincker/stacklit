---
import stars from '../data/stars.json';
import copy from '../data/copy.json';
import { REPO } from '../data/site';
import Button from './Button.astro';
import UiIcon from './UiIcon.astro';
interface Props { variant?: 'primary' | 'secondary' | 'ghost'; size?: 'md' | 'sm'; label?: string; compact?: boolean; class?: string }
const { variant = 'secondary', size = 'md', label = copy.cta.star, compact = false, class: extra } = Astro.props;
const n = stars.stars;
const shown = typeof n === 'number' ? (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n)) : null;
---
<Button href={REPO} variant={variant} size={size} class={extra} ariaLabel={compact ? `${copy.cta.star}${shown ? `, ${n} stars` : ''}` : undefined}>
  <UiIcon name="star" size={16} class="text-accent-text" />
  <span class:list={[compact && 'hidden sm:inline']}>{label}</span>
  {shown && <span class="rounded-full bg-sunk px-2 text-caption tabular-nums" aria-hidden={compact ? 'true' : undefined} aria-label={compact ? undefined : `${n} stars`}>{shown}</span>}
</Button>
