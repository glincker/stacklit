---
import Container from './Container.astro';
const links = [
  ['GitHub', 'https://github.com/glincker/stacklit'],
  ['npm', 'https://www.npmjs.com/package/stacklit'],
  ['MIT license', 'https://github.com/glincker/stacklit/blob/master/LICENSE'],
  ['FAQ', '/docs/faq/'],
  ['Privacy', '/docs/privacy/'],
  ['Changelog', '/docs/changelog/'],
  ['llms.txt', '/llms.txt'],
];
---
<footer class="border-t border-line bg-surface py-12">
  <Container>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      {links.map(([label, href]) => <li><a href={href} class="inline-flex min-h-9 items-center text-body text-ink underline decoration-1 underline-offset-4 hover:decoration-2">{label}</a></li>)}
    </ul>
    <p class="mt-6 max-w-measure text-caption text-muted">No cookies, no analytics, no third party scripts, fonts or images. This site makes no third party requests. The star count is read once, when the site is built.</p>
  </Container>
</footer>
