---
import Container from './Container.astro';
// One section: full-bleed band, vertical rhythm from the section token, content in a Container.
interface Props { id?: string; tone?: 'paper' | 'surface' | 'sunk'; size?: 'lg' | 'md' | 'hero'; label?: string; class?: string }
const { id, tone = 'paper', size = 'lg', label, class: extra } = Astro.props;
const sizes = { lg: 'py-section', md: 'py-12 sm:py-16', hero: 'pb-12 pt-10 sm:pb-16 sm:pt-16' } as const;
const tones = { paper: 'bg-paper', surface: 'bg-surface border-y border-line', sunk: 'bg-sunk' } as const;
---
<section id={id} aria-labelledby={label} class:list={[sizes[size], tones[tone], extra]}>
  <Container><slot /></Container>
</section>
