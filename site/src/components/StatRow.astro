---
// Three headline results, each a plain sentence first, one big number, then what it means. Favourable, neutral
// and unfavourable results share one size and one style; only the unfavourable one takes the drift colour.
interface Item { polarity: 'good' | 'neutral' | 'bad'; sentence: string; number: string; means: string; href: string }
interface Props { items: Item[]; class?: string }
const { items, class: extra } = Astro.props;
const tone = { good: 'text-accent-text', neutral: 'text-ink', bad: 'text-bad' } as const;
---
<ul class:list={['grid grid-cols-1 border-t border-ink md:grid-cols-3', extra]}>
  {items.map((it) => (
    <li class="reveal flex min-w-0 flex-col gap-4 border-b border-line py-8 md:border-s md:px-8 md:first:border-s-0 md:first:ps-0">
      <h3 class="max-w-[16ch] text-h2 font-bold text-ink">{it.sentence}</h3>
      <p class:list={['text-stat font-bold', tone[it.polarity]]}>{it.number}</p>
      <p class="text-body text-muted"><span class="text-caption font-semibold text-ink">What this means</span><br />{it.means}</p>
    </li>
  ))}
</ul>
