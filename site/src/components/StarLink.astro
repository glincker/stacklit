---
import stars from '../data/stars.json';
import copy from '../data/copy.json';
import { REPO } from '../data/site';
const { variant = 'primary', label = copy.cta.star } = Astro.props;
const n = stars.stars;
const shown = typeof n === 'number' ? (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k` : String(n)) : null;
---
<a class:list={['btn', 'star', variant === 'primary' ? 'btn-primary' : 'btn-quiet']} href={REPO} rel="noopener">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z" fill="currentColor"/></svg>
  <span>{label}</span>
  {shown && <span class="count" aria-label={`${n} stars`}>{shown}</span>}
</a>
