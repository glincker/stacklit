---
import UiIcon from './UiIcon.astro';
// One button, a pill. Labels never wrap inside a button (the link form may wrap, it is plain text).
// icon: a @thesvg/ui icon before the label; trail: an icon after it (the link form defaults to an arrow).
interface Props { href: string; variant?: 'primary' | 'secondary' | 'ghost' | 'link'; size?: 'md' | 'sm'; class?: string; ariaLabel?: string; icon?: string; trail?: string | false }
const { href, variant = 'secondary', size = 'md', class: extra, ariaLabel, icon, trail } = Astro.props;
const base = 'group/btn lift inline-flex items-center justify-center gap-2 font-semibold transition-colors duration-fast ease-stack motion-reduce:transition-none';
const variants = {
  primary: 'rounded-full bg-accent text-accent-ink whitespace-nowrap hover:brightness-110',
  secondary: 'rounded-full border border-line-strong bg-raised text-ink whitespace-nowrap hover:bg-sunk',
  ghost: 'rounded-full text-ink whitespace-nowrap hover:bg-sunk',
  link: 'min-h-11 text-accent-text underline decoration-1 underline-offset-4 hover:decoration-2',
} as const;
const sizes = { md: 'min-h-11 px-5 text-body', sm: 'min-h-9 px-3 text-caption' } as const;
const end = trail === undefined ? (variant === 'link' ? 'arrow-right' : undefined) : trail || undefined;
const px = size === 'sm' ? 14 : 16;
---
<a href={href} aria-label={ariaLabel} class:list={[base, variants[variant], variant !== 'link' && sizes[size], 'active:brightness-95 aria-disabled:pointer-events-none aria-disabled:opacity-50', extra]}>{icon && <UiIcon name={icon} size={px} />}<slot />{end && <UiIcon name={end} size={px} class="transition-transform duration-fast group-hover/btn:translate-x-0.5 motion-reduce:transition-none" />}</a>
