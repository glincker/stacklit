---
// A section kicker: the circled index and a mono label, like a map reference. Metadata only.
interface Props { n: string; label: string; class?: string }
const { n, label, class: extra } = Astro.props;
---
<p class:list={['label-mono flex items-center gap-3 text-muted', extra]}>
  <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line-strong text-ink" aria-hidden="true">{n}</span>
  <span><span class="sr-only">Section {n}, </span>{label}</span>
</p>
