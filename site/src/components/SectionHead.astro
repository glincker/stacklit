---
import Kicker from './Kicker.astro';
// Kicker, a giant statement, then a two column intro: text on the left, the legend (spec table) on the right.
interface Props { id: string; title: string; n: string; label: string; lead?: string }
const { id, title, n, label, lead } = Astro.props;
const hasText = Boolean(lead) || Astro.slots.has('default');
const hasLegend = Astro.slots.has('legend');
---
<header class="mb-12 min-w-0 sm:mb-16">
  <Kicker n={n} label={label} class="reveal" />
  <h2 id={id} class="reveal mt-8 max-w-[22ch] text-statement font-bold text-ink">{title}</h2>
  {(hasText || hasLegend) && (
    <div class="mt-10 grid min-w-0 gap-10 lg:grid-cols-12 lg:gap-12">
      <div class:list={['reveal min-w-0', hasLegend ? 'lg:col-span-7' : 'lg:col-span-8']}>
        {lead && <p class="max-w-measure text-lead text-ink">{lead}</p>}
        <slot />
      </div>
      {hasLegend && <aside class="reveal min-w-0 lg:col-span-5 lg:border-l lg:border-line lg:pl-10"><slot name="legend" /></aside>}
    </div>
  )}
</header>
