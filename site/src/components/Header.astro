---
import Container from './Container.astro';
import Button from './Button.astro';
import StarButton from './StarButton.astro';
const { path = '/' } = Astro.props;
const here = (p: string) => (path.startsWith(p) ? 'page' : undefined);
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur-sm">
  <Container as="div" class="flex min-h-16 items-center justify-between gap-3">
    <a href="/" class="inline-flex min-h-11 items-center gap-2 text-h3 font-bold tracking-tight text-ink" aria-label="Stacklit home">
      <svg viewBox="0 0 24 24" class="size-6" aria-hidden="true" focusable="false"><rect x="8" y="3" width="13" height="5" rx="1.5" class="fill-accent"/><rect x="3" y="9.5" width="18" height="5" rx="1.5" class="fill-ink"/><rect x="3" y="16" width="13" height="5" rx="1.5" class="fill-ink"/></svg>
      <span>stacklit</span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Main">
      <Button href="/docs/quickstart/" variant="ghost" size="sm" class="aria-[current=page]:bg-sunk" ariaLabel="Docs">Docs</Button>
      <Button href="/demos/" variant="ghost" size="sm" class="aria-[current=page]:bg-sunk">Demos</Button>
      <Button href="/docs/benchmarks/" variant="ghost" size="sm" class="hidden sm:inline-flex">Benchmarks</Button>
      <StarButton variant="secondary" size="sm" label="GitHub" />
      <button type="button" data-theme-toggle class="grid size-10 place-items-center rounded-md text-ink transition-colors duration-fast hover:bg-sunk motion-reduce:transition-none" aria-label="Switch between light and dark theme">
        <svg viewBox="0 0 24 24" class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
        <svg viewBox="0 0 24 24" class="hidden size-5 dark:block" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </Container>
</header>
