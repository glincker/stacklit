---
import StarButton from './StarButton.astro';
import UiIcon from './UiIcon.astro';
// Three floating pills: the logo, the nav and the GitHub action. On phones the nav pill docks at the bottom of the
// screen so nothing collapses behind a menu button. CSS only, every link is a real link.
const { path = '/' } = Astro.props;
const items: [string, string, (p: string) => boolean][] = [
  ['Home', '/', (p) => p === '/'],
  ['Docs', '/docs/quickstart/', (p) => p.startsWith('/docs/') && !p.startsWith('/docs/benchmarks')],
  ['Demos', '/demos/', (p) => p.startsWith('/demos')],
  ['Benchmarks', '/docs/benchmarks/', (p) => p.startsWith('/docs/benchmarks')],
];
const ring = 'pill rounded-full border border-ring bg-raised';
---
<header class="sticky top-0 z-40 w-full border-b border-line bg-paper/90">
<div class="mx-auto grid w-full max-w-site grid-cols-[1fr_auto] items-center gap-3 px-gutter py-3 md:grid-cols-[1fr_auto_1fr]">
  <a href="/" class:list={['pointer-events-auto inline-flex min-h-11 items-center gap-2 justify-self-start px-4 text-body font-bold tracking-tight text-ink', ring]} aria-label="Stacklit home">
    <svg viewBox="0 0 24 24" class="size-5" aria-hidden="true" focusable="false"><rect x="8" y="3" width="13" height="5" rx="1.5" class="fill-accent"/><rect x="3" y="9.5" width="18" height="5" rx="1.5" class="fill-ink"/><rect x="3" y="16" width="13" height="5" rx="1.5" class="fill-ink"/></svg>
    <span>stacklit</span>
  </a>
  <nav aria-label="Main" class:list={['pointer-events-auto fixed inset-x-0 bottom-4 z-40 mx-auto flex w-fit max-w-[calc(100%-2rem)] items-center gap-1 p-1 md:static md:bottom-auto md:max-w-none', ring]}>
    {items.map(([label, href, on]) => (
      <a href={href} aria-current={on(path) ? 'page' : undefined} class="inline-flex min-h-11 items-center whitespace-nowrap rounded-full px-2.5 text-caption font-medium text-muted transition-colors duration-fast hover:text-ink aria-[current=page]:bg-ink aria-[current=page]:text-paper motion-reduce:transition-none sm:px-4">{label === 'Benchmarks' ? <><span class="sm:hidden">Bench</span><span class="hidden sm:inline">Benchmarks</span></> : label}</a>
    ))}
  </nav>
  <div class:list={['pointer-events-auto flex items-center gap-1 justify-self-end p-1', ring]}>
    <StarButton variant="ghost" size="sm" label="GitHub" compact class="min-h-11" />
    <button type="button" data-theme-toggle class="grid size-11 place-items-center rounded-full text-ink transition-colors duration-fast hover:bg-sunk motion-reduce:transition-none" aria-label="Switch between light and dark theme">
      <UiIcon name="moon" size={20} class="dark:hidden" />
      <UiIcon name="sun" size={20} class="hidden dark:block" />
    </button>
  </div>
</div>
</header>
